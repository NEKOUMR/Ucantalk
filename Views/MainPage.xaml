<Page
    x:Class="VRC_cantalkcn.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    SizeChanged="Page_SizeChanged"
    FontFamily="{StaticResource AppFontFamily}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="PanelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="PanelComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle x:Name="BackgroundBaseRect" Grid.RowSpan="3" IsHitTestVisible="False"/>
        <Rectangle x:Name="BackgroundImageRect" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="BackgroundFrostRect" Grid.RowSpan="3" IsHitTestVisible="False"/>
        <Rectangle x:Name="BackgroundToneOverlayRect" Grid.RowSpan="3" IsHitTestVisible="False"/>

        <Grid Grid.Row="0" x:Name="TitleBarHost" Background="#22000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock x:Name="TitleBarText"
                           Text="Ucantalk"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.85"/>
            </Border>
            <Grid Grid.Column="1"/>
        </Grid>

        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="RootNav_SelectionChanged" OpenPaneLength="180" CompactPaneLength="44">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="主页" Tag="home" Icon="Home"/>
                <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings" Icon="Setting"/>
                <NavigationViewItem x:Name="NavVoice" Content="语音引擎" Tag="voice" Icon="Volume"/>
                <NavigationViewItem x:Name="NavPlugins" Content="插件" Tag="plugins" Icon="AllApps"/>
                <NavigationViewItem x:Name="NavTranslation" Content="翻译设置" Tag="translation" Icon="Globe"/>
                <NavigationViewItem x:Name="NavSpeech" Content="语音识别" Tag="speech" Icon="Microphone"/>
                <NavigationViewItem x:Name="NavPlayer" Content="音频播放器" Tag="player" Icon="Play"/>
                <NavigationViewItem x:Name="NavLogs" Content="日志" Tag="logs" Icon="Document"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="about" Icon="Help"/>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid x:Name="HomePanel">
                    <ScrollViewer Padding="12" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="主页" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="输入内容" FontWeight="SemiBold"/>
                                    <TextBox
                                        x:Name="InputTextBox"
                                        PlaceholderText="输入要说的话"
                                        AcceptsReturn="False"
                                        MinHeight="72"
                                        TextWrapping="Wrap"
                                        KeyDown="InputTextBox_KeyDown"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SendButton" Content="发送并朗读" Click="SendButton_Click"/>
                                        <Button
                                            x:Name="VoiceToggleButton"
                                            Content="点击说话 (单击)"
                                            Click="VoiceToggleButton_Click"
                                            PointerPressed="VoiceToggleButton_PointerPressed"
                                            PointerReleased="VoiceToggleButton_PointerReleased"
                                            PointerCanceled="VoiceToggleButton_PointerCanceled"
                                            PointerCaptureLost="VoiceToggleButton_PointerCaptureLost"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SpeechPreviewText" Text="语音识别输出: -" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="快捷卡片" FontWeight="SemiBold"/>
                                    <TextBlock Text="快捷卡片（点击直接发送，可自定义）" Opacity="0.75"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QuickPhraseInputBox" Grid.Column="0" PlaceholderText="输入卡片内容，例如：你好"/>
                                        <Button x:Name="QuickPhraseAddButton" Grid.Column="1" Content="添加" Click="QuickPhraseAddButton_Click"/>
                                    </Grid>
                                    <ListView
                                        x:Name="QuickPhraseListView"
                                        Height="132"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.IsHorizontalRailEnabled="True"
                                        ScrollViewer.IsVerticalRailEnabled="False"
                                        ItemClick="QuickPhraseListView_ItemClick">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Margin" Value="0,0,10,0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="220"
                                                    MinHeight="96"
                                                    Padding="10"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="点击发送" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="删除" Tag="{Binding}" Click="QuickPhraseDeleteButton_Click"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch x:Name="RecentSpeechHistorySwitch" Header="记录最近10句并可重发" Toggled="RecentSpeechHistorySwitch_Toggled"/>
                                    <Grid x:Name="RecentSpeechHistoryPanel" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="最近10句（左右滑动，点击卡片可重发）" Opacity="0.75"/>
                                        <ListView
                                            x:Name="RecentSpeechHistoryListView"
                                            Grid.Row="1"
                                            Height="132"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ScrollViewer.HorizontalScrollMode="Enabled"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.VerticalScrollMode="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.IsHorizontalRailEnabled="True"
                                            ScrollViewer.IsVerticalRailEnabled="False"
                                            ItemClick="RecentSpeechHistoryListView_ItemClick">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="250"
                                                        MinHeight="96"
                                                        Padding="10"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="点击重发" Opacity="0.7" FontSize="12"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="微调" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="语速" VerticalAlignment="Center"/>
                                        <Slider x:Name="EdgeRateSlider" Grid.Row="0" Grid.Column="1" Minimum="-50" Maximum="50" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="EdgeRateLabel" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="语调" VerticalAlignment="Center"/>
                                        <Slider x:Name="EdgePitchSlider" Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="50" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="EdgePitchLabel" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="音量" VerticalAlignment="Center"/>
                                        <Slider x:Name="VolumeSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="300" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="VolumeLabel" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="GPT语速" VerticalAlignment="Center"/>
                                        <Slider x:Name="GptSpeedSlider" Grid.Row="3" Grid.Column="1" Minimum="0.5" Maximum="2.0" StepFrequency="0.1" ValueChanged="Slider_ValueChanged"/>
                                        <TextBlock x:Name="GptSpeedLabel" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch x:Name="EnableTextOutputSwitch" Header="输出文字到聊天框" IsOn="True" Grid.Column="0"/>
                                        <ToggleSwitch x:Name="EnableTtsSwitch" Header="启用TTS朗读" IsOn="True" Grid.Column="1"/>
                                        <ToggleSwitch x:Name="ForceSyncSwitch" Header="强制音画同步" IsOn="True" Grid.Column="2"/>
                                        <ToggleSwitch x:Name="CleanPuncSwitch" Header="GPT 去标点" IsOn="False" Grid.Column="3"/>
                                        <ToggleSwitch x:Name="AutoSendSwitch" Header="语音识别后自动发送" Grid.Column="4" Toggled="AutoSendSwitch_Toggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="84" Height="84" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image x:Name="QrImage" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="手机控制端 (扫码连接)" FontWeight="SemiBold"/>
                                        <TextBlock Text="手机和电脑需连同一个 WiFi" Opacity="0.75"/>
                                        <TextBlock x:Name="WebUrlText" Text="http://127.0.0.1:5000" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="设置" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="音频路由 (双声卡输出)" FontWeight="SemiBold"/>
                                    <TextBlock Text="监听设备 (给自己听)"/>
                                    <ComboBox x:Name="MonitorDeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                    <TextBlock Text="VRC设备 (给麦克风/VBCable)"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="VrcDeviceCombo" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        <Button Grid.Column="1" Content="刷新" Click="RefreshAudioBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <ComboBox x:Name="UiLanguageCombo" Header="界面语言" SelectionChanged="UiLanguageCombo_SelectionChanged">
                                        <ComboBoxItem Tag="zh" Content="中文"/>
                                        <ComboBoxItem Tag="en" Content="English"/>
                                        <ComboBoxItem Tag="ja" Content="日本語"/>
                                        <ComboBoxItem Tag="ko" Content="한국어"/>
                                    </ComboBox>
                                    <TextBlock Text="外观" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="ThemeModeCombo" Header="界面主题" SelectionChanged="AppearanceControl_Changed">
                                        <ComboBoxItem Tag="system" Content="跟随系统"/>
                                        <ComboBoxItem Tag="dark" Content="深色"/>
                                        <ComboBoxItem Tag="light" Content="浅色"/>
                                    </ComboBox>
                                    <StackPanel x:Name="AppearanceAdvancedPanel" Spacing="10">
                                        <Grid x:Name="AccentColorRow" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AccentColorBox" Grid.Column="0" Header="UI 主色 (Hex, 例: #4CC2FF)" PlaceholderText="#4CC2FF" TextChanged="AppearanceControl_Changed"/>
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="取色">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <ColorPicker x:Name="AccentColorPicker" Width="280" IsAlphaEnabled="False" ColorChanged="AccentColorPicker_ColorChanged"/>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="BackgroundColorRow" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BackgroundColorBox" Grid.Column="0" Header="背景颜色 (Hex, 例: #1F1F1F)" PlaceholderText="#1F1F1F" TextChanged="AppearanceControl_Changed"/>
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="取色">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <ColorPicker x:Name="BackgroundColorPicker" Width="280" IsAlphaEnabled="False" ColorChanged="BackgroundColorPicker_ColorChanged"/>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BackgroundImagePathBox" Header="背景图片路径 (可选)" Grid.Column="0" TextChanged="AppearanceControl_Changed"/>
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择图片" Click="BrowseBackgroundButton_Click"/>
                                            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="清除背景图" Click="ClearBackgroundButton_Click"/>
                                        </Grid>
                                        <TextBlock Text="磨砂强度 (0-100)"/>
                                        <Slider x:Name="BackgroundBlurSlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="AppearanceSlider_ValueChanged"/>
                                        <TextBlock Text="背景亮暗度 (-100 ~ 100)"/>
                                        <Slider x:Name="BackgroundBrightnessSlider" Minimum="-100" Maximum="100" StepFrequency="1" ValueChanged="AppearanceSlider_ValueChanged"/>
                                        <Button HorizontalAlignment="Left" Content="恢复默认外观" Click="ResetAppearanceButton_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="HostIpBox" Header="本机局域网IP"/>
                                    <TextBox x:Name="HotkeyBox" Header="全局唤醒热键（点击后直接按键，如 f9 或 ctrl+q）" IsReadOnly="True" GotFocus="HotkeyCaptureBox_GotFocus" KeyDown="HotkeyCaptureBox_KeyDown"/>
                                    <TextBox x:Name="SpeechHotkeyBox" Header="语音识别热键（点击后直接按键，如 f5）" IsReadOnly="True" GotFocus="HotkeyCaptureBox_GotFocus" KeyDown="HotkeyCaptureBox_KeyDown"/>
                                    <TextBox x:Name="SendHotkeyBox" Header="发送热键（点击后直接按键，如 f6）" IsReadOnly="True" GotFocus="HotkeyCaptureBox_GotFocus" KeyDown="HotkeyCaptureBox_KeyDown"/>
                                    <TextBox x:Name="ProxyBox" Header="代理地址"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BatPathBox" Header="GPT-SoVITS 自动启动 (api.bat)" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="BrowseBatButton_Click"/>
                                    </Grid>
                                    <Button HorizontalAlignment="Right" Content="保存配置" Click="SaveConfigButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="VoicePanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="语音引擎" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProfileCombo" Header="角色档案" SelectionChanged="ProfileCombo_SelectionChanged"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="新建" Click="NewProfileButton_Click"/>
                                        <Button Grid.Column="2" VerticalAlignment="Bottom" Content="删除" Click="DeleteProfileButton_Click"/>
                                        <Button Grid.Column="3" VerticalAlignment="Bottom" Content="保存档案并切模型" Click="SaveProfileButton_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProfileNameBox" Header="当前档案名称" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="重命名当前档案" Click="RenameProfileButton_Click"/>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="EngineCombo" Header="TTS 引擎" Grid.Column="0">
                                            <x:String>Edge</x:String>
                                            <x:String>GPT-SoVITS</x:String>
                                            <x:String>FishAudio</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="TextLangCombo" Header="输入语言" Grid.Column="1">
                                            <x:String>zh</x:String>
                                            <x:String>en</x:String>
                                            <x:String>ja</x:String>
                                            <x:String>ko</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="EdgeVoiceCombo" Header="Edge 发音人" Grid.Column="2">
                                            <x:String>zh-CN-XiaoxiaoNeural</x:String>
                                            <x:String>zh-CN-YunxiNeural</x:String>
                                            <x:String>ja-JP-NanamiNeural</x:String>
                                            <x:String>en-US-AnaNeural</x:String>
                                            <x:String>ko-KR-SunHiNeural</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <TextBox x:Name="GptApiUrlBox" Header="API 地址" PlaceholderText="http://127.0.0.1:9880"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GptModelPathBox" Header="GPT 模型路径 (*.ckpt)" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="BrowseGptModelButton_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SovitsModelPathBox" Header="SoVITS 模型路径 (*.pth)" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="BrowseSovitsModelButton_Click"/>
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RefAudioPathBox" Header="音频语音 (参考音频路径)" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择" Click="BrowseRefAudioButton_Click"/>
                                    </Grid>
                                    <TextBox x:Name="PromptTextBox" Header="音频文字"/>
                                    <ComboBox x:Name="PromptLangCombo" Header="音频语言">
                                        <x:String>zh</x:String>
                                        <x:String>en</x:String>
                                        <x:String>ja</x:String>
                                        <x:String>ko</x:String>
                                    </ComboBox>

                                    <TextBox x:Name="FishKeyBox" Header="Fish API Key"/>
                                    <TextBox x:Name="FishRefIdBox" Header="Fish 引用 ID"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ExtensionsPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="插件" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="插件" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="插件目录" Click="OpenPluginFolderButton_Click"/>
                                        <Button Content="重载插件" Click="ReloadPluginsButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="TranslationPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="翻译设置" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch x:Name="TranslationEnabledSwitch" Header="启用翻译"/>
                                    <TextBlock Text="请选择需要显示在聊天框的语言（最多勾选 3 个，建议包含中文）" Opacity="0.8"/>
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="TargetZhCheckBox" Grid.Row="0" Grid.Column="0" Content="中文" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetEnCheckBox" Grid.Row="0" Grid.Column="1" Content="英语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetJaCheckBox" Grid.Row="0" Grid.Column="2" Content="日语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetKoCheckBox" Grid.Row="0" Grid.Column="3" Content="韩语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetRuCheckBox" Grid.Row="1" Grid.Column="0" Content="俄语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetFrCheckBox" Grid.Row="1" Grid.Column="1" Content="法语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetDeCheckBox" Grid.Row="1" Grid.Column="2" Content="德语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetEsCheckBox" Grid.Row="1" Grid.Column="3" Content="西语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetThCheckBox" Grid.Row="2" Grid.Column="0" Content="泰语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetViCheckBox" Grid.Row="2" Grid.Column="1" Content="越语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetIdCheckBox" Grid.Row="2" Grid.Column="2" Content="印尼语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                        <CheckBox x:Name="TargetArCheckBox" Grid.Row="2" Grid.Column="3" Content="阿语" Checked="TranslationTargetCheckBox_Changed" Unchecked="TranslationTargetCheckBox_Changed"/>
                                    </Grid>

                                    <TextBlock Text="强制输出（自动发音）" FontWeight="SemiBold"/>
                                    <TextBlock Text="选择后：输入文本会优先翻译到该语言，再交给 TTS 朗读。" Opacity="0.78"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="TranslationEngineCombo" Header="翻译引擎" Grid.Column="0">
                                            <x:String>Universal</x:String>
                                            <x:String>Google</x:String>
                                            <x:String>DeepL</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="MainTargetCombo" Header="TTS 强制语言" Grid.Column="1">
                                            <ComboBoxItem Tag="">不指定（默认读原文）</ComboBoxItem>
                                            <ComboBoxItem Tag="zh">中文</ComboBoxItem>
                                            <ComboBoxItem Tag="en">英语</ComboBoxItem>
                                            <ComboBoxItem Tag="ja">日语</ComboBoxItem>
                                            <ComboBoxItem Tag="ko">韩语</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="AI 预设（兼容 OpenAI 格式）" FontWeight="SemiBold"/>
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="智谱(免费)" Click="PresetZhipuButton_Click"/>
                                            <Button Content="DeepSeek" Click="PresetDeepSeekButton_Click"/>
                                            <Button Content="Kimi" Click="PresetKimiButton_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="硅基(Qwen)" Click="PresetSiliconButton_Click"/>
                                            <Button Content="Ollama" Click="PresetOllamaButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBox x:Name="UniApiBox" Header="通用 API 地址"/>
                                    <TextBox x:Name="UniKeyBox" Header="通用 API Key"/>
                                    <TextBox x:Name="UniModelBox" Header="通用模型名称"/>
                                    <TextBox x:Name="UniPromptBox" Header="通用翻译提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>
                                    <TextBox x:Name="DeepLKeyBox" Header="DeepL API Key（可选）"/>
                                    <Button HorizontalAlignment="Stretch" Content="保存翻译设置并生效" Click="SaveTranslationButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SpeechPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="语音识别" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SpeechMicCombo" Grid.Column="0" Header="麦克风设备" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        <Button x:Name="RefreshSpeechMicButton" Grid.Column="1" VerticalAlignment="Bottom" Content="刷新" Click="RefreshAudioBtn_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SpeechEngineCombo" Header="语音识别引擎" Grid.Column="0" SelectionChanged="SpeechEngineCombo_SelectionChanged">
                                            <x:String>Windows</x:String>
                                            <x:String>Vosk</x:String>
                                            <x:String>Sherpa-ONNX</x:String>
                                        </ComboBox>
                                        <Button x:Name="BrowseVoskModelButton" Grid.Column="1" VerticalAlignment="Bottom" Content="选择 Vosk 模型目录" Click="BrowseVoskModelButton_Click"/>
                                    </Grid>
                                    <ComboBox x:Name="SpeechTriggerModeCombo" Header="触发模式" SelectionChanged="SpeechTriggerModeCombo_SelectionChanged">
                                        <ComboBoxItem Tag="toggle" Content="单击开关 (Toggle)"/>
                                        <ComboBoxItem Tag="ptt" Content="长按说话 (Push-to-Talk)"/>
                                        <ComboBoxItem x:Name="SpeechTriggerContinuousItem" Tag="continuous" Content="连续对话 (Continuous)"/>
                                    </ComboBox>
                                    <TextBox x:Name="VoskModelPathBox" Header="Vosk 模型路径"/>
                                    <Grid x:Name="SherpaModelRow" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SherpaModelPathBox" Grid.Column="0" Header="Sherpa-ONNX 模型目录"/>
                                        <Button x:Name="BrowseSherpaModelButton" Grid.Column="1" VerticalAlignment="Bottom" Content="选择 Sherpa 模型目录" Click="BrowseSherpaModelButton_Click"/>
                                    </Grid>
                                    <ComboBox x:Name="SherpaProviderCombo" Header="ONNX 推理后端">
                                        <x:String>cpu</x:String>
                                        <x:String>dml</x:String>
                                        <x:String>cuda</x:String>
                                    </ComboBox>
                                    <ToggleSwitch x:Name="SpeechAutoSendSwitch" Header="识别后自动发送" Toggled="AutoSendSwitch_Toggled"/>
                                    <ToggleSwitch x:Name="SpeechCueSwitch" Header="语音提示音（开始/结束/发送）"/>
                                    <ToggleSwitch x:Name="CaptureDuringTtsSwitch" Header="并行模式：TTS 播放时继续采集"/>
                                    <TextBlock
                                        x:Name="CaptureModeHintText"
                                        Text="开：边播边采（响应更快，可能串音）；关：稳定模式（播放 TTS 时暂停采集）。"
                                        Opacity="0.82"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PlayerPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="音频播放器" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PlayerFileBox" Header="音频文件" Grid.Column="0"/>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="打开文件" Click="BrowsePlayerFileButton_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PlayerMonitorDeviceCombo" Grid.Column="0" Header="播放器监听设备 (给自己听)" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        <ComboBox x:Name="PlayerVrcDeviceCombo" Grid.Column="1" Header="播放器 VRC设备 (给麦克风/VBCable)" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        <Button x:Name="PlayerRoutePlayButton" Grid.Column="2" VerticalAlignment="Bottom" Content="路由播放" Click="PlayerRoutePlayButton_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="音量" VerticalAlignment="Center"/>
                                        <Slider x:Name="PlayerVolumeSlider" Grid.Column="1" Minimum="0" Maximum="300" ValueChanged="PlayerVolumeSlider_ValueChanged"/>
                                        <TextBlock x:Name="PlayerVolumeLabel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="PlayerPlayButton" Content="播放 / 暂停" Click="PlayerPlayButton_Click"/>
                                        <Button x:Name="PlayerStopButton" Content="停止" Click="PlayerStopButton_Click"/>
                                        <TextBlock x:Name="PlayerTimeText" VerticalAlignment="Center" Text="00:00 / 00:00"/>
                                    </StackPanel>
                                    <Slider x:Name="PlayerPositionSlider" Minimum="0" Maximum="1" PointerPressed="PlayerPositionSlider_PointerPressed" PointerReleased="PlayerPositionSlider_PointerReleased"/>
                                    <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" Height="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LogsPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="日志" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="刷新日志" Click="RefreshLogsButton_Click"/>
                                        <Button Content="清空日志" Click="ClearLogsButton_Click"/>
                                        <Button Content="打开日志目录" Click="OpenLogsFolderButton_Click"/>
                                        <Button Content="复制日志" Click="CopyLogsButton_Click"/>
                                    </StackPanel>
                                    <TextBox
                                        x:Name="LogsTextBox"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        FontFamily="Consolas"
                                        MinHeight="360"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="14" HorizontalContentAlignment="Left">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}"/>
                            <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"/>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PanelComboBoxStyle}"/>
                            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource PanelToggleStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="10" HorizontalAlignment="Left" MinWidth="760">
                            <TextBlock Text="关于" Style="{StaticResource PanelHeaderTextStyle}"/>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Ucantalk" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="面向 VRChat / 实时文字转语音 / 翻译 / 语音识别的一体化桌面工具。" TextWrapping="Wrap"/>
                                    <Grid ColumnSpacing="20" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="作者" Opacity="0.78"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="NEKO_UMR"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="版本" Opacity="0.78"/>
                                        <TextBlock x:Name="AboutVersionText" Grid.Row="1" Grid.Column="1" Text="-"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="运行目录" Opacity="0.78"/>
                                        <TextBlock x:Name="AboutInstallPathText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="-"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="数据目录" Opacity="0.78"/>
                                        <TextBlock x:Name="AboutDataPathText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="-"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="打开数据目录" Click="OpenAppDataFolderButton_Click"/>
                                        <Button Content="打开日志目录" Click="OpenLogsFolderButton_Click"/>
                                        <Button Content="复制版本信息" Click="CopyAboutInfoButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="主要功能" FontWeight="SemiBold"/>
                                    <TextBlock Text="1. 文本发送与语音朗读" TextWrapping="Wrap"/>
                                    <TextBlock Text="2. GPT-SoVITS / Edge / FishAudio 多引擎支持" TextWrapping="Wrap"/>
                                    <TextBlock Text="3. 翻译、TTS 强制语言与手机控制端联动" TextWrapping="Wrap"/>
                                    <TextBlock Text="4. Windows / Vosk / Sherpa-ONNX 语音识别" TextWrapping="Wrap"/>
                                    <TextBlock Text="5. 日志、角色档案、播放器与设备路由" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="第三方组件" FontWeight="SemiBold"/>
                                    <TextBlock Text="WinUI 3 / Windows App SDK" TextWrapping="Wrap"/>
                                    <TextBlock Text="NAudio / WebView2 / Newtonsoft.Json / QRCoder" TextWrapping="Wrap"/>
                                    <TextBlock Text="Vosk / sherpa-onnx / ffmpeg" TextWrapping="Wrap"/>
                                    <TextBlock Text="外部引擎与模型版权归各自项目及作者所有。" TextWrapping="Wrap" Opacity="0.78"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <Border Grid.Row="2" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10,8">
            <TextBlock x:Name="StatusText" Text="就绪"/>
        </Border>
    </Grid>
</Page>




